# Étape 1 : Build Angular
FROM node:20-alpine AS build

WORKDIR /app

# Optimisation du cache : Installation des dépendances
COPY package*.json ./
# Utilisation de 'npm ci' au lieu de 'install' pour les environnements CI/CD (plus rapide et fiable)
RUN npm ci

# Copier le reste du projet et lancer le build
COPY . .
RUN npm run build -- --configuration=production

# Étape 2 : Serveur Nginx pour la production
FROM nginx:1.27-alpine

# Nettoyage de la configuration par défaut
RUN rm -rf /etc/nginx/conf.d/*

# Copier ta configuration personnalisée (Reverse Proxy /api)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copier les fichiers buildés
# Note : Pour Angular 17, le chemin est souvent dist/money-wise/browser
# On utilise cette syntaxe pour être sûr de copier le contenu du dossier de build
COPY --from=build /app/dist/money-wise/browser /usr/share/nginx/html

# Fallback : Si le dossier /browser n'existe pas, on tente la racine du dist
# (L'instruction suivante ne bloquera pas le build si le dossier est déjà rempli)
RUN if [ ! -f /usr/share/nginx/html/index.html ]; then \
    cp -r /app/dist/money-wise/* /usr/share/nginx/html/; \
    fi

# Sécurité et permissions
RUN chmod -R 755 /usr/share/nginx/html && \
    chown -R nginx:nginx /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s \
  CMD curl -f http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]